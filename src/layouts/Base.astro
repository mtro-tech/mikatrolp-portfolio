---
import { Font } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import "../styles/global.css";

interface Props {
  locale: string;
  title: string;
  description: string;
  skipLink: string;
}

const { locale, title, description, skipLink } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={getAbsoluteLocaleUrl(locale)} />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl("en")} />
    <link rel="alternate" hreflang="de" href={getAbsoluteLocaleUrl("de")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-hanken-grotesk" preload />
  </head>
  <body>
    <a
      href="#main"
      class="bg-paper sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:px-4 focus:py-2"
    >
      {skipLink}
    </a>
    <slot />
  </body>
</html>
