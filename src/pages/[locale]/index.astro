---
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Academy from "../../components/chapters/Academy.astro";
import Arrival from "../../components/chapters/Arrival.astro";
import BehindTheBar from "../../components/chapters/BehindTheBar.astro";
import CheckIn from "../../components/chapters/CheckIn.astro";
import CheckOut from "../../components/chapters/CheckOut.astro";
import ConciergeOfTheFuture from "../../components/chapters/ConciergeOfTheFuture.astro";
import Foundations from "../../components/chapters/Foundations.astro";
import NextDestination from "../../components/chapters/NextDestination.astro";
import Header from "../../components/Header.astro";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return ["en", "de"].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const other = locale === "en" ? "de" : "en";

const site = (await getEntry("site", locale))!.data;
const otherSite = (await getEntry("site", other))!.data;

const chapters = (
  await getCollection("chapters", ({ id }) => id.startsWith(`${locale}/`))
).sort((a, b) => a.data.order - b.data.order);
const [arrival, checkIn, foundations, bar, academy, next, concierge, checkOut] =
  chapters;

// "2027-02-15" → day, month and year; "2025-08" → month and year only.
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(locale === "de" ? "de-CH" : "en-GB", {
    day: value.length > 7 ? "numeric" : undefined,
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(value));

// A stop's role, dates and status on one line: "Intern · 2 February 2026 – 31 July 2026".
const meta = (data: (typeof chapters)[number]["data"]) =>
  [
    data.role,
    data.period &&
      [data.period.start, data.period.end]
        .filter((d) => d !== undefined)
        .map(formatDate)
        .join(" – "),
    data.status && data.status !== "past" && site.statusLabels[data.status],
  ]
    .filter(Boolean)
    .join(" · ");
---

<Base
  locale={locale}
  title={site.name}
  description={arrival.data.body[0]}
  skipLink={site.skipLink}
>
  <Header
    name={site.name}
    homeHref={getRelativeLocaleUrl(locale)}
    stage={arrival.data.stage}
    languageSwitchLabel={site.languageSwitchLabel}
    other={{
      locale: other,
      href: getRelativeLocaleUrl(other),
      languageName: otherSite.languageName,
    }}
    motion={site.motion}
  />

  <main id="main">
    <Arrival
      stage={arrival.data.stage}
      heading={arrival.data.heading}
      line={arrival.data.body[0]}
      place={arrival.data.place}
      coordinates={arrival.data.coordinates}
    />

    <CheckIn
      stage={checkIn.data.stage}
      heading={checkIn.data.heading}
      beats={checkIn.data.beats ?? {}}
      items={checkIn.data.items}
      place={checkIn.data.place}
      origin={arrival.data.place}
    />

    <Foundations
      stage={foundations.data.stage}
      heading={foundations.data.heading}
      beats={foundations.data.beats ?? {}}
    />

    <BehindTheBar
      stage={bar.data.stage}
      heading={bar.data.heading}
      meta={meta(bar.data)}
      beats={bar.data.beats ?? {}}
    />

    <Academy
      stage={academy.data.stage}
      heading={academy.data.heading}
      meta={meta(academy.data)}
      start={academy.data.period && formatDate(academy.data.period.start)}
      end={academy.data.period?.end && formatDate(academy.data.period.end)}
      beats={academy.data.beats ?? {}}
      items={academy.data.items}
    />

    <NextDestination
      stage={next.data.stage}
      heading={next.data.heading}
      meta={meta(next.data)}
      beats={next.data.beats ?? {}}
      origin={checkIn.data.place}
      place={next.data.place}
      date={next.data.period && formatDate(next.data.period.start)}
      hotel={next.data.organisation?.name}
    />

    <ConciergeOfTheFuture
      stage={concierge.data.stage}
      heading={concierge.data.heading}
      beats={concierge.data.beats ?? {}}
    />

    <CheckOut
      stage={checkOut.data.stage}
      heading={checkOut.data.heading}
      beats={checkOut.data.beats ?? {}}
      links={site.links}
      form={site.contactForm ? site.guestbook : undefined}
      privacyHref={`/${locale}/privacy/`}
    />
  </main>

  <footer class="mx-auto flex max-w-2xl gap-6 p-6">
    <a href={site.links.linkedin} rel="noopener noreferrer">
      LinkedIn
    </a>
    <a href={site.links.github} rel="noopener noreferrer">
      GitHub
    </a>
  </footer>
</Base>

<script>
  import "../../lib/motion/main";
  import "../../lib/scroll";
</script>
