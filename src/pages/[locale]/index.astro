---
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Arrival from "../../components/chapters/Arrival.astro";
import Header from "../../components/Header.astro";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return ["en", "de"].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const other = locale === "en" ? "de" : "en";

const site = (await getEntry("site", locale))!.data;
const otherSite = (await getEntry("site", other))!.data;

const chapters = (
  await getCollection("chapters", ({ id }) => id.startsWith(`${locale}/`))
).sort((a, b) => a.data.order - b.data.order);
const [arrival, ...stops] = chapters;

// "2027-02-15" → day, month and year; "2025-08" → month and year only.
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(locale === "de" ? "de-CH" : "en-GB", {
    day: value.length > 7 ? "numeric" : undefined,
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(value));
---

<Base
  locale={locale}
  title={site.name}
  description={arrival.data.body[0]}
  skipLink={site.skipLink}
>
  <Header
    name={site.name}
    homeHref={getRelativeLocaleUrl(locale)}
    stage={arrival.data.stage}
    languageSwitchLabel={site.languageSwitchLabel}
    other={{
      locale: other,
      href: getRelativeLocaleUrl(other),
      languageName: otherSite.languageName,
    }}
    motion={site.motion}
  />

  <main id="main">
    <Arrival
      heading={arrival.data.heading}
      line={arrival.data.body[0]}
      place={arrival.data.place}
      coordinates={arrival.data.coordinates}
    />

    <!-- Plain placeholders until step 4 designs each chapter. -->
    <div class="mx-auto max-w-2xl space-y-16 p-6">
      {stops.map(({ data }) => (
        <section class="space-y-4">
          <h2 class="font-display text-chapter italic">{data.stage}</h2>
          <p class="font-semibold">{data.heading}</p>
          {(data.role || data.period || data.status) && (
            <p class="text-ink-soft">
              {[
                data.role,
                data.period &&
                  [data.period.start, data.period.end]
                    .filter((d) => d !== undefined)
                    .map(formatDate)
                    .join(" – "),
                data.status &&
                  data.status !== "past" &&
                  site.statusLabels[data.status],
              ]
                .filter(Boolean)
                .join(" · ")}
            </p>
          )}
          {data.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {data.items?.map((item) => (
            <p>
              <span class="font-semibold">{item.label}:</span>{" "}
              {item.values.join(", ")}
            </p>
          ))}
        </section>
      ))}
    </div>
  </main>

  <footer class="mx-auto flex max-w-2xl gap-6 p-6">
    <a href={site.links.linkedin} rel="noopener noreferrer">
      LinkedIn
    </a>
    <a href={site.links.github} rel="noopener noreferrer">
      GitHub
    </a>
  </footer>
</Base>

<script>
  import "../../lib/motion/main";
</script>
