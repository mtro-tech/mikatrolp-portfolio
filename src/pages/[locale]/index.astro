---
// Step 2 placeholder: proves that content, i18n, fonts and tokens work together.
// Step 3 replaces it with the Arrival hero; no design decisions live here.
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return ["en", "de"].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const other = locale === "en" ? "de" : "en";

const site = (await getEntry("site", locale))!.data;
const otherSite = (await getEntry("site", other))!.data;

const chapters = (
  await getCollection("chapters", ({ id }) => id.startsWith(`${locale}/`))
).sort((a, b) => a.data.order - b.data.order);
const [arrival, ...stops] = chapters;

// "2027-02-15" → day, month and year; "2025-08" → month and year only.
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(locale === "de" ? "de-CH" : "en-GB", {
    day: value.length > 7 ? "numeric" : undefined,
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(value));
---

<Base
  locale={locale}
  title={site.name}
  description={arrival.data.body[0]}
  skipLink={site.skipLink}
>
  <header class="mx-auto flex max-w-2xl items-baseline justify-between p-6">
    <span class="font-display">{site.name}</span>
    <nav aria-label={site.languageSwitchLabel}>
      <a href={getRelativeLocaleUrl(other)} lang={other} hreflang={other}>
        {otherSite.languageName}
      </a>
    </nav>
  </header>

  <main id="main" class="mx-auto max-w-2xl space-y-16 p-6">
    <section>
      <h1 class="font-display text-display">{arrival.data.heading}</h1>
      <p class="mt-4">{arrival.data.body[0]}</p>
    </section>

    {stops.map(({ data }) => (
      <section class="space-y-4">
        <h2 class="font-display text-chapter italic">{data.stage}</h2>
        <p class="font-semibold">{data.heading}</p>
        {(data.role || data.period || data.status) && (
          <p class="text-ink-soft">
            {[
              data.role,
              data.period &&
                [data.period.start, data.period.end]
                  .filter((d) => d !== undefined)
                  .map(formatDate)
                  .join(" – "),
              data.status &&
                data.status !== "past" &&
                site.statusLabels[data.status],
            ]
              .filter(Boolean)
              .join(" · ")}
          </p>
        )}
        {data.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {data.items?.map((item) => (
          <p>
            <span class="font-semibold">{item.label}:</span>{" "}
            {item.values.join(", ")}
          </p>
        ))}
      </section>
    ))}
  </main>

  <footer class="mx-auto flex max-w-2xl gap-6 p-6">
    <a href={site.links.linkedin} rel="noopener noreferrer">
      LinkedIn
    </a>
    <a href={site.links.github} rel="noopener noreferrer">
      GitHub
    </a>
  </footer>
</Base>
