---
// Behind the bar as a staged scene (the frame is .stage-frame in src/styles/route.css).
// - With motion on, the frame is held on screen and behind-the-bar.motion.ts plays the
//   scene: the room, the house, the pour (one moment where red floods the frame),
//   responsibility and growth, learning the new.
// - With motion off (or no JavaScript) the same markup is a normal section: the drawing
//   in its finished state and every line of text visible. The flood is not shown.
import BarScene from "../route/BarScene.astro";
import ChapterHeading from "./ChapterHeading.astro";

interface Props {
  stage: string;
  heading: string;
  /** Role and dates, already formatted for the language. */
  meta?: string;
  /** The copy in lines, grouped by moment: joined, today, responsibility, growth, learning. */
  beats: Record<string, string[]>;
}

const { stage, heading, meta, beats } = Astro.props;
---

<section class="bar" data-bar data-stage-name={stage}>
  <div class="stage-frame" data-stage-frame>
    <div class="scene" data-stage-scene>
      <div class="layer layer--desktop">
        <BarScene part="desktop" />
      </div>
      <div class="layer layer--phone">
        <BarScene part="phone" />
      </div>
    </div>

    {/* The pour that floods the frame: decorative, animated version only. */}
    <div class="flood" data-flood aria-hidden="true">
      {Array.from({ length: 8 }, () => (
        <span class="rising" />
      ))}
    </div>

    <div class="copy">
      <div class="stage-slot">
        {Object.entries(beats).map(([moment, lines], index) => (
          <div class="group" data-group={moment}>
            {/* The heading belongs to the first moment, so later ones start at the top. */}
            {index === 0 && (
              <div class="title" data-title>
                <ChapterHeading stage={stage} heading={heading} />
                {meta && <p class="mt-1 text-ink-soft">{meta}</p>}
              </div>
            )}
            <div class="lines font-display text-quote">
              {lines.map((line) => (
                <p data-line>{line}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .layer--desktop {
    display: none;
  }

  .lines {
    display: grid;
    gap: 0.5rem;
    text-wrap: balance;
  }

  .title {
    margin-bottom: 1rem;
  }

  /* ---- Motion off: a normal scrolling section ------------------------------------ */
  .flood {
    display: none;
  }

  .copy {
    position: relative;
    padding: 1.5rem var(--spacing-page) 3rem calc(10% + 1.25rem);
  }

  @media (width >= 60rem) {
    .layer--desktop {
      display: block;
    }

    .layer--phone {
      display: none;
    }

    /* The drawing lies behind; the copy takes the column left of the counter (x < 600). */
    .scene {
      position: absolute;
      inset: 0;
    }

    .copy {
      width: 30%;
      margin-left: 8.33%;
      padding: 7vw 0 4rem;
    }

    /* Stacked, the large beat size would not fit the column. */
    :global(html:not([data-motion="on"])) .lines {
      font-size: var(--text-lead);
      line-height: var(--text-lead--line-height);
    }
  }

  /* ---- Motion on: the scene plays inside the held frame -------------------------- */
  /* Phones: the drawing in the top 46% of the frame, the text below. The drawing
     shrinks from the rail's top if the screen is short (--stage-fit, src/lib/scroll.ts). */
  :global(html[data-motion="on"]) .scene {
    --zoom: var(--stage-fit, 1);

    position: absolute;
    inset: 0 0 54% 0;
    scale: var(--stage-fit, 1);
    transform-origin: 10% 0;
  }

  :global(html[data-motion="on"]) .layer {
    position: absolute;
    inset: 0 0 auto 0;
  }

  /* The flood rises from below the frame until it covers it: taller than the frame,
     with a curved top like the surface of a drink. It lies over the drawing and
     under the text. */
  :global(html[data-motion="on"]) .flood {
    display: block;
    position: absolute;
    z-index: 2;
    inset: -12% 0 0 0;
    border-radius: 50% 50% 0 0 / 5rem 5rem 0 0;
    background: var(--color-route);
    opacity: 0;
  }

  .rising {
    position: absolute;
    bottom: 8%;
    width: 0.7rem;
    height: 0.7rem;
    border: calc(var(--route-stroke-width) * 1px) solid var(--color-paper);
    border-radius: 50%;
    animation: flood-rise var(--duration-drift) ease-in infinite;
  }

  .rising:nth-child(1) {
    left: 8%;
  }

  .rising:nth-child(2) {
    left: 21%;
    animation-delay: calc(var(--duration-drift) * -0.3);
  }

  .rising:nth-child(3) {
    left: 34%;
    animation-delay: calc(var(--duration-drift) * -0.65);
  }

  .rising:nth-child(4) {
    left: 47%;
    animation-delay: calc(var(--duration-drift) * -0.15);
  }

  .rising:nth-child(5) {
    left: 59%;
    animation-delay: calc(var(--duration-drift) * -0.8);
  }

  .rising:nth-child(6) {
    left: 71%;
    animation-delay: calc(var(--duration-drift) * -0.45);
  }

  .rising:nth-child(7) {
    left: 83%;
    animation-delay: calc(var(--duration-drift) * -0.55);
  }

  .rising:nth-child(8) {
    left: 93%;
    animation-delay: calc(var(--duration-drift) * -0.9);
  }

  @keyframes flood-rise {
    from {
      translate: 0 0;
      opacity: 0;
    }

    15% {
      opacity: 0.9;
    }

    to {
      translate: 1rem -70vh;
      opacity: 0;
    }
  }

  :global(html[data-motion="on"]) .copy {
    position: absolute;
    z-index: 3;
    inset: 46% 0 0 0;
    padding: 0.5rem var(--spacing-page) 1.5rem calc(10% + 1.25rem);
  }

  /* The lines of a moment replace each other, so they share one place. */
  :global(html[data-motion="on"]) .lines {
    gap: 0;
  }

  :global(html[data-motion="on"]) .lines > * {
    grid-area: 1 / 1;
  }

  /* On the red, text is paper-coloured. */
  :global(html[data-motion="on"]) [data-group="today"] {
    color: var(--color-paper);
  }

  /* Nothing is on stage before its moment (behind-the-bar.motion.ts brings each one in). */
  :global(html[data-motion="on"]) .title,
  :global(html[data-motion="on"]) [data-line] {
    opacity: 0;
  }

  @media (width >= 60rem) {
    /* Desktop: the drawing fills the frame and shrinks from where the route enters. */
    :global(html[data-motion="on"]) .scene {
      inset: 0;
      transform-origin: 50% 0;
    }

    :global(html[data-motion="on"]) .copy {
      inset: 13% auto 0 8.33%;
      width: 31%;
      margin: 0;
      padding: 0;
    }
  }
</style>
