---
// Check-out: the guestbook, the last chapter. The route that drew the whole journey
// becomes the pen line that rules the guestbook's page, and ends in a full stop.
// - Desktop, motion on: the frame is held for a short while and check-out.motion.ts
//   plays the scene: the book opens, the pen rules the lines, the links drop in as
//   tags, the route signs off. Then the frame stays as the last thing on the page.
// - Phones: a normal section, never held. A form inside a held frame is hard to use
//   on a small screen. The two pages stack; pieces fade in as they scroll into view.
// - Motion off: the open book with everything visible.
// The book is markup, not a drawing, so its text and its form are real. On desktop it
// lies over the drawing in the same box (1440 × 810), so both shrink together on a
// short screen.
// The contact form is built only when `form` is given (src/content/site: contactForm).
// Until its endpoint and the privacy notice exist, the right page is an empty ruled
// page (CLAUDE.md §7).
import GuestbookScene from "../route/GuestbookScene.astro";
import ChapterHeading from "./ChapterHeading.astro";

interface Props {
  stage: string;
  heading: string;
  /** The copy in lines: open (the invitation), more (the links). */
  beats: Record<string, string[]>;
  links: { linkedin: string; github: string };
  /** The form's interface text. Without it, no form is built. */
  form?: {
    name: string;
    email: string;
    message: string;
    send: string;
    sending: string;
    thanks: string;
    error: string;
    privacy: string;
    trap: string;
  };
  privacyHref: string;
}

const { stage, heading, beats, links, form, privacyHref } = Astro.props;
const profiles = [
  { name: "LinkedIn", href: links.linkedin },
  { name: "GitHub", href: links.github },
];
// An empty guestbook page has five lines.
const emptyLines = [0, 1, 2, 3, 4];
---

<section class="check-out" data-check-out data-stage-name={stage}>
  <div class="stage-frame" data-stage-frame>
    <div class="scene" data-stage-scene>
      <div class="drawing">
        <GuestbookScene />
      </div>

      <div class="spread">
        <div class="book" data-book>
          <div class="page page--left" data-book-left>
            <div class="title reveal" data-title>
              <ChapterHeading stage={stage} heading={heading} />
            </div>
            {beats.open?.map((line) => (
              <p class="line font-display reveal" data-line="open">
                {line}
              </p>
            ))}
            {beats.more?.map((line) => (
              <p class="line font-display reveal" data-line="more">
                {line}
              </p>
            ))}
            <ul class="tags reveal" data-tags>
              {profiles.map(({ name, href }) => (
                <li data-tag>
                  <a class="tag" href={href} rel="noopener noreferrer">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="page page--right">
            {form ? (
              <form
                class="sheet reveal"
                method="post"
                action="/api/contact"
                data-guestbook
                data-sending={form.sending}
                data-thanks={form.thanks}
                data-error={form.error}
              >
                <div data-fields>
                  <p class="field">
                    <label for="guestbook-name">{form.name}</label>
                    <input
                      id="guestbook-name"
                      name="name"
                      type="text"
                      autocomplete="name"
                      maxlength="100"
                      required
                    />
                    <span class="track" data-rule>
                      <span class="rule">
                        <i />
                      </span>
                    </span>
                  </p>
                  <p class="field">
                    <label for="guestbook-email">{form.email}</label>
                    <input
                      id="guestbook-email"
                      name="email"
                      type="email"
                      autocomplete="email"
                      maxlength="254"
                      required
                    />
                    <span class="track" data-rule>
                      <span class="rule">
                        <i />
                      </span>
                    </span>
                  </p>
                  <p class="field">
                    <label for="guestbook-message">{form.message}</label>
                    <textarea
                      id="guestbook-message"
                      name="message"
                      rows="4"
                      maxlength="2000"
                      required
                    />
                    <span class="track" data-rule>
                      <span class="rule">
                        <i />
                      </span>
                    </span>
                  </p>
                  {/* A trap for bots: people and screen readers never meet it. */}
                  <p class="trap" aria-hidden="true">
                    <label>
                      {form.trap}
                      <input
                        name="website"
                        type="text"
                        tabindex="-1"
                        autocomplete="off"
                      />
                    </label>
                  </p>
                  <p class="sign" data-seal>
                    <button class="seal" type="submit" data-send>
                      {form.send}
                    </button>
                    <a class="privacy" href={privacyHref}>
                      {form.privacy}
                    </a>
                  </p>
                </div>
                <p class="status font-display" role="status" data-status />
              </form>
            ) : (
              <div class="sheet sheet--empty reveal" aria-hidden="true">
                {emptyLines.map(() => (
                  <span class="track" data-rule>
                    <span class="rule">
                      <i />
                    </span>
                  </span>
                ))}
              </div>
            )}
          </div>

          <span class="cover" data-book-cover aria-hidden="true"></span>
        </div>
      </div>
    </div>
    {/* Phones: the rail ends here, in a full stop. */}
    <span class="full-stop" aria-hidden="true"></span>
  </div>
</section>

<script>
  // The guestbook form (only on the page when it is switched on). It sends the three
  // fields to the site's own endpoint and shows thanks or a general error. Nothing is
  // stored in the browser.
  const form = document.querySelector<HTMLFormElement>("[data-guestbook]");
  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]");
    const fields = form.querySelector<HTMLElement>("[data-fields]");
    const send = form.querySelector<HTMLButtonElement>("[data-send]");
    const label = send?.textContent ?? "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!send || !status || !fields) return;
      send.disabled = true;
      send.textContent = form.dataset.sending ?? label;
      status.textContent = "";
      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!response.ok) throw new Error(String(response.status));
        fields.hidden = true;
        status.textContent = form.dataset.thanks ?? "";
      } catch {
        // General on purpose: no details of what went wrong (CLAUDE.md §7).
        status.textContent = form.dataset.error ?? "";
        send.disabled = false;
        send.textContent = label;
      }
    });

    // Someone who tabs into the form before the held scene has played is taken to
    // the scene's end, so nobody types into a page that is not shown yet.
    form.addEventListener("focusin", () => {
      const spacer = form.closest(".pin-spacer");
      if (!spacer) return;
      const end = spacer.getBoundingClientRect().bottom + scrollY - innerHeight;
      if (scrollY < end) scrollTo(0, end);
    });
  }
</script>

<style>
  .book {
    --line: calc(var(--route-stroke-width) * 1px);
    --board: 0.4rem;

    position: relative;
    display: grid;
    gap: 2rem;
  }

  /* A page in the house style: paper with an ink outline, on the cover's red board
     (which shows as a rim around it). */
  .page {
    position: relative;
    padding: 1.5rem 1.4rem 1.75rem;
    border: var(--line) solid var(--color-ink);
    border-radius: 0.35rem;
    background: var(--color-paper);
    box-shadow:
      0 0 0 var(--board) var(--color-route),
      0 0 0 calc(var(--board) + var(--line)) var(--color-ink);
  }

  .line {
    margin-top: 1rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    text-wrap: balance;
  }

  /* The links hang as tags from a brass rail (.tags, .tag: src/styles/route.css). */
  .tags {
    margin-top: 1.5rem;
  }

  .tag {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .tag:hover {
    text-decoration: underline;
  }

  /* ---- The right page: lines to write on -------------------------------------- */
  .sheet {
    display: grid;
    gap: 1rem;
  }

  .sheet--empty {
    gap: 2.4rem;
    padding-top: 2.2rem;
  }

  /* A writing line. The track keeps its place and width; the rule inside is what the
     pen draws. Its red layer is the wet stroke, which dries to ink. */
  .track {
    display: block;
    height: var(--line);
  }

  .rule {
    position: relative;
    display: block;
    height: 100%;
    background: var(--color-ink);
    transform-origin: 0 50%;
  }

  .rule i {
    position: absolute;
    inset: 0;
    background: var(--color-route);
    opacity: 0;
  }

  .field {
    display: grid;
  }

  .field label {
    color: var(--color-ink-soft);
    font-size: 0.875em;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.3rem 0 0.35rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    resize: none;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: calc(var(--line) * 1) solid var(--color-route);
    outline-offset: 2px;
  }

  /* Off the page for everyone but bots. */
  .trap {
    position: absolute;
    left: -200vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .sign {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }

  /* The send button: a brass seal. */
  .seal {
    padding: 0.6rem 1.2rem;
    border: var(--line) solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-brass);
    color: var(--color-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .seal:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .privacy {
    font-size: 0.875em;
  }

  .status:empty {
    display: none;
  }

  .status {
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  /* The closed cover: only the animated desktop version shows it. */
  .cover {
    display: none;
  }

  /* ---- Phones: a normal section ------------------------------------------------- */
  .drawing {
    display: none;
  }

  .spread {
    padding: 2.5rem var(--spacing-page) 5rem calc(10% + 1.25rem);
  }

  /* Never held on phones, whatever the motion setting (route.css gives held frames a
     fixed height). */
  :global(html[data-motion="on"]) .stage-frame {
    height: auto;
  }

  /* The rail stops above the frame's end, in a full stop: the end of the route. */
  .stage-frame::before {
    inset-block: 0 3rem;
  }

  .full-stop {
    position: absolute;
    bottom: calc(3rem - 0.45rem);
    left: 10%;
    width: 0.9rem;
    height: 0.9rem;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--color-route);
  }

  :global(html[data-motion="on"]) .full-stop {
    animation: idle-pulse var(--duration-pulse) ease-in-out infinite;
  }

  /* Pieces fade in as they scroll into view, where the browser can do that. */
  @supports (animation-timeline: view()) {
    @media (width < 60rem) {
      :global(html[data-motion="on"]) .reveal {
        animation: guestbook-reveal linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 70%;
      }
    }
  }

  @keyframes guestbook-reveal {
    from {
      opacity: 0;
      translate: 0 1.25rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ---- Desktop: the book lies over the drawing, in the same box ------------------ */
  @media (width >= 60rem) {
    /* Above the book, so the pen can write on it; clicks pass through to the page. */
    .drawing {
      display: block;
      position: relative;
      z-index: 1;
      pointer-events: none;
    }

    .full-stop {
      display: none;
    }

    /* The drawing's box: as wide as the page, 1440 × 810. It shrinks on a short
       screen (--stage-fit, src/lib/scroll.ts), around the route in the middle. */
    .scene {
      --zoom: var(--stage-fit, 1);

      position: absolute;
      inset: 0 0 auto 0;
      aspect-ratio: 1440 / 810;
      scale: var(--stage-fit, 1);
      transform-origin: 50% 0;
      container-type: inline-size;
    }

    /* The book: x 187–1253, y 130–640 of the drawing; its spine at x = 720. */
    .spread {
      position: absolute;
      inset: 16.05% 13% 21% 13%;
      padding: 0;
      /* Everything in the book grows with the page, like the drawing. */
      font-size: max(0.9rem, 1.15cqw);
    }

    .book {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      height: 100%;
    }

    .page {
      padding: 2em 2.2em;
      overflow: hidden;
    }

    .page--left {
      border-radius: 0.5rem 0 0 0.5rem;
    }

    .page--right {
      border-radius: 0 0.5rem 0.5rem 0;
    }

    .line {
      margin-top: 0.8em;
      font-size: 1.5em;
      line-height: 1.3;
    }

    .tags {
      margin-top: 1.4em;
    }

    .sheet {
      gap: 1.3em;
    }

    .sheet--empty {
      gap: 3.4em;
      padding-top: 3.6em;
    }

    .field textarea {
      height: 6.5em;
    }

    .status {
      font-size: 1.5em;
      line-height: 1.3;
    }

    :global(html[data-motion="on"]) .stage-frame {
      height: max(calc(100svh - var(--header-height)), 34rem);
    }

    /* The closed cover lies over the right page until the book opens. */
    :global(html[data-motion="on"]) .cover {
      display: block;
      position: absolute;
      inset: calc(var(--board) * -1) calc(var(--board) * -1)
        calc(var(--board) * -1) 50%;
      border: var(--line) solid var(--color-ink);
      border-radius: 0.2rem 0.6rem 0.6rem 0.2rem;
      background: var(--color-route);
    }

    /* A title band on the cover. */
    :global(html[data-motion="on"]) .cover::after {
      content: "";
      position: absolute;
      inset: 30% 18% auto 18%;
      height: calc(var(--line) * 2);
      border-radius: var(--line);
      background: var(--color-paper);
    }

    /* Nothing is on stage before its moment (check-out.motion.ts brings each in). */
    :global(html[data-motion="on"]) [data-book],
    :global(html[data-motion="on"]) .title,
    :global(html[data-motion="on"]) [data-line],
    :global(html[data-motion="on"]) [data-tags],
    :global(html[data-motion="on"]) [data-tag],
    :global(html[data-motion="on"]) [data-seal],
    :global(html[data-motion="on"]) .field label,
    :global(html[data-motion="on"]) .field input,
    :global(html[data-motion="on"]) .field textarea {
      opacity: 0;
    }

    :global(html[data-motion="on"]) .rule {
      transform: scaleX(0);
    }
  }
</style>
