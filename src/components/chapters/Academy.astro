---
// The academy as a staged scene (the frame is .stage-frame in src/styles/route.css).
// - With motion on, the frame is held on screen and academy.motion.ts plays the scene:
//   Lucerne's waterfront builds, the bridge blooms, the pin lands, and three books
//   drop into the text column and open on the favourite modules.
// - With motion off (or no JavaScript) the same markup is a normal section: the drawing
//   in its finished state and every line of text visible.
import AcademyScene from "../route/AcademyScene.astro";
import ChapterHeading from "./ChapterHeading.astro";

interface Props {
  stage: string;
  heading: string;
  /** The dates of the programme, already formatted for the language. */
  meta?: string;
  start?: string;
  end?: string;
  /** The copy in lines, grouped by moment (here one group: studying). */
  beats: Record<string, string[]>;
  /** The favourite modules, as a labelled list. */
  items?: { label: string; values: string[] }[];
}

const { stage, heading, meta, start, end, beats, items = [] } = Astro.props;
---

<section class="academy" data-academy data-stage-name={stage}>
  <div class="stage-frame" data-stage-frame>
    <div class="scene" data-stage-scene>
      <div class="layer layer--desktop">
        <AcademyScene part="desktop" start={start} end={end} />
      </div>
      <div class="layer layer--phone">
        <AcademyScene part="phone" />
      </div>
    </div>

    <div class="copy">
      <div class="stage-slot">
        {Object.entries(beats).map(([moment, lines], index) => (
          <div class="group" data-group={moment}>
            {/* The heading belongs to the first moment, so later ones start at the top. */}
            {index === 0 && (
              <div class="title" data-title>
                <ChapterHeading stage={stage} heading={heading} />
                {meta && <p class="mt-1 text-ink-soft">{meta}</p>}
              </div>
            )}
            <div class="lines font-display text-quote">
              {lines.map((line) => (
                <p data-line>{line}</p>
              ))}
            </div>
          </div>
        ))}
        {items.map((item) => (
          <div class="group modules" data-group="modules">
            <p class="font-semibold" data-modules-label>
              {item.label}
            </p>
            {/* Each module is a book: its name is on the page, the cover and the inside
                of the cover are decoration. Drawn open; academy.motion.ts closes each
                one and opens it at its moment. */}
            <ul class="books font-display text-lead">
              {item.values.map((value) => (
                <li class="book" data-book>
                  <span class="inside" data-book-inside aria-hidden="true" />
                  <span class="page" data-module>
                    {value}
                  </span>
                  <span class="cover" data-book-cover aria-hidden="true" />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .layer--desktop {
    display: none;
  }

  .lines {
    display: grid;
    gap: 0.5rem;
    text-wrap: balance;
  }

  .title {
    margin-bottom: 1rem;
  }

  /* The modules: three open books in the house style (flat fills, an ink outline).
     --spine is where the book is bound: the page lies right of it, the opened cover
     left of it. */
  .books {
    --spine: 22%;
    --line: calc(var(--route-stroke-width) * 1px);

    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    /* Narrower than the column, so the books stay clear of the bridge on short screens. */
    max-width: min(27rem, 94%);
  }

  .book {
    --cover: var(--color-route);

    position: relative;
    display: block;
    padding-left: var(--spine);
  }

  .book:nth-child(3n + 2) {
    --cover: var(--color-brass);
  }

  .book:nth-child(3n) {
    --cover: var(--color-paper-deep);
  }

  .page {
    display: flex;
    align-items: center;
    position: relative;
    min-height: 5.5rem;
    padding: 0.75rem 1.75rem 0.75rem 1.1rem;
    border: var(--line) solid var(--color-ink);
    border-radius: 0 0.5rem 0.5rem 0;
    background: var(--color-paper);
    text-wrap: balance;
  }

  /* The edges of the pages behind the open one. */
  .page::after {
    content: "";
    position: absolute;
    inset: 0 0.4rem 0 auto;
    width: 0.3rem;
    border-inline: var(--line) solid var(--color-paper-deep);
  }

  /* The opened cover, seen from inside, left of the spine. */
  .inside,
  .cover {
    position: absolute;
    top: 0;
    bottom: 0;
    border: var(--line) solid var(--color-ink);
    background: var(--cover);
  }

  .inside {
    left: 0;
    width: calc(var(--spine) + var(--line));
    border-radius: 0.5rem 0 0 0.5rem;
  }

  /* The closed cover lies over the page; only the animated version shows it. */
  .cover {
    display: none;
    left: var(--spine);
    right: 0;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  /* A title band on the cover. */
  .cover::after {
    content: "";
    position: absolute;
    inset: 32% 16% auto 12%;
    height: calc(var(--line) * 2);
    border-radius: var(--line);
    background: var(--color-paper);
  }

  /* ---- Motion off: a normal scrolling section ------------------------------------ */
  .copy {
    position: relative;
    padding: 1.5rem var(--spacing-page) 3rem calc(10% + 1.25rem);
  }

  @media (width >= 60rem) {
    .layer--desktop {
      display: block;
    }

    .layer--phone {
      display: none;
    }

    /* Without motion the whole text is shown at once, which the shore beside the bridge
       has no room for: the drawing comes first and the copy follows below it, right
       of the route on its way out (x = 360 of 1440). */
    .copy {
      width: 50%;
      margin-left: 30%;
      padding: 1rem 0 4rem;
    }

    /* Stacked, the large beat size would not fit the column. */
    :global(html:not([data-motion="on"])) .lines {
      font-size: var(--text-lead);
      line-height: var(--text-lead--line-height);
    }
  }

  /* ---- Motion on: the scene plays inside the held frame -------------------------- */
  /* Phones: the drawing in the top 46% of the frame, the text below. The drawing
     shrinks from the rail's top if the screen is short (--stage-fit, src/lib/scroll.ts). */
  :global(html[data-motion="on"]) .scene {
    --zoom: var(--stage-fit, 1);

    position: absolute;
    inset: 0 0 54% 0;
    scale: var(--stage-fit, 1);
    transform-origin: 10% 0;
  }

  :global(html[data-motion="on"]) .layer {
    position: absolute;
    inset: 0 0 auto 0;
  }

  :global(html[data-motion="on"]) .copy {
    position: absolute;
    inset: 46% 0 0 0;
    padding: 0.5rem var(--spacing-page) 1.5rem calc(10% + 1.25rem);
  }

  /* The lines of a moment replace each other, so they share one place. */
  :global(html[data-motion="on"]) .lines {
    gap: 0;
  }

  :global(html[data-motion="on"]) .lines > * {
    grid-area: 1 / 1;
  }

  /* Nothing is on stage before its moment (academy.motion.ts brings each one in). */
  :global(html[data-motion="on"]) .title,
  :global(html[data-motion="on"]) [data-line],
  :global(html[data-motion="on"]) [data-modules-label],
  :global(html[data-motion="on"]) [data-book] {
    opacity: 0;
  }

  :global(html[data-motion="on"]) .cover {
    display: block;
  }

  @media (width >= 60rem) {
    /* Desktop: the drawing fills the frame and shrinks from where the route enters. */
    :global(html[data-motion="on"]) .scene {
      inset: 0;
      transform-origin: 72.22% 0;
    }

    :global(html[data-motion="on"]) .copy {
      inset: 13% auto 0 8.33%;
      width: 31%;
      margin: 0;
      padding: 0;
    }
  }
</style>
