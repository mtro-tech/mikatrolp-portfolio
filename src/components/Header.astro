---
import MotionToggle from "./MotionToggle.astro";

interface Props {
  name: string;
  homeHref: string;
  stage: string;
  languageSwitchLabel: string;
  other: { locale: string; href: string; languageName: string };
  motion: { label: string; on: string; off: string };
}

const { name, homeHref, stage, languageSwitchLabel, other, motion } =
  Astro.props;
---

<!-- Phones: name and controls on the first row, the stage name on its own row.
     From 48rem: one row with the stage name centred. -->
<header class="site-header px-page">
  <a href={homeHref} class="name no-underline">
    {name}
  </a>
  <!-- The stage name follows the scroll once the other chapters exist (step 4). -->
  <span data-stage class="stage font-display text-stage italic">
    {stage}
  </span>
  <div class="controls">
    <MotionToggle {...motion} />
    <nav aria-label={languageSwitchLabel}>
      <a href={other.href} lang={other.locale} hreflang={other.locale}>
        {other.languageName}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "name controls"
      "stage stage";
    align-content: center;
    align-items: baseline;
    gap: 0.25rem 1rem;
    height: var(--header-height);
    background: var(--header-bg, var(--color-paper));
    color: var(--header-fg, var(--color-ink));
    white-space: nowrap;
    transition:
      background-color var(--duration-tone) ease,
      color var(--duration-tone) ease;
  }

  /* While a scene fills the frame with a colour, the header takes it too
     (toneHeader in src/lib/motion/stage.ts sets data-tone). Paper-coloured text passes
     AA contrast on both: about 12:1 on pine ink, 5.7:1 on aperitivo red. */
  .site-header[data-tone="ink"] {
    --header-bg: var(--color-ink);
    --header-fg: var(--color-paper);
  }

  .site-header[data-tone="red"] {
    --header-bg: var(--color-route);
    --header-fg: var(--color-paper);
  }

  /* On a colour, every piece of header text is paper-coloured: the red link and the
     grey switch would not be readable there, and the red focus ring would vanish. */
  .site-header[data-tone] :global(:is(a, button)) {
    color: var(--header-fg);
    transition: color var(--duration-tone) ease;
  }

  .site-header[data-tone] :global(:focus-visible) {
    outline-color: var(--header-fg);
  }

  .name {
    grid-area: name;
    color: inherit;
  }

  .stage {
    grid-area: stage;
  }

  .controls {
    grid-area: controls;
    display: flex;
    gap: 1.25rem;
  }

  @media (width >= 48rem) {
    .site-header {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: "name stage controls";
    }

    .controls {
      justify-self: end;
    }
  }
</style>
