---
interface Props {
  name: string;
  homeHref: string;
  stage: string;
  languageSwitchLabel: string;
  other: { locale: string; href: string; languageName: string };
}

const { name, homeHref, stage, languageSwitchLabel, other } = Astro.props;
---

<!-- The side columns take their content's width; the stage name gets the rest,
     shrinks on small screens and wraps onto two lines only when it still does not fit. -->
<header class="px-page grid grid-cols-[auto_minmax(0,1fr)_auto] items-baseline gap-4 py-5 whitespace-nowrap">
  <a href={homeHref} class="text-ink justify-self-start no-underline">
    {name}
  </a>
  <!-- The stage name follows the scroll once the other chapters exist (step 4). -->
  <span
    data-stage
    class="font-display text-stage text-center text-balance whitespace-normal italic"
  >
    {stage}
  </span>
  <nav aria-label={languageSwitchLabel} class="justify-self-end">
    <a href={other.href} lang={other.locale} hreflang={other.locale}>
      {other.languageName}
    </a>
  </nav>
</header>
