---
import MotionToggle from "./MotionToggle.astro";

interface Props {
  name: string;
  homeHref: string;
  stage: string;
  languageSwitchLabel: string;
  other: { locale: string; href: string; languageName: string };
  motion: { label: string; on: string; off: string };
}

const { name, homeHref, stage, languageSwitchLabel, other, motion } =
  Astro.props;
---

<!-- Phones: name and controls on the first row, the stage name on its own row.
     From 48rem: one row with the stage name centred. -->
<header class="site-header px-page">
  <a href={homeHref} class="name text-ink no-underline">
    {name}
  </a>
  <!-- The stage name follows the scroll once the other chapters exist (step 4). -->
  <span data-stage class="stage font-display text-stage italic">
    {stage}
  </span>
  <div class="controls">
    <MotionToggle {...motion} />
    <nav aria-label={languageSwitchLabel}>
      <a href={other.href} lang={other.locale} hreflang={other.locale}>
        {other.languageName}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "name controls"
      "stage stage";
    align-content: center;
    align-items: baseline;
    gap: 0.25rem 1rem;
    height: var(--header-height);
    background: var(--color-paper);
    white-space: nowrap;
  }

  .name {
    grid-area: name;
  }

  .stage {
    grid-area: stage;
  }

  .controls {
    grid-area: controls;
    display: flex;
    gap: 1.25rem;
  }

  @media (width >= 48rem) {
    .site-header {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: "name stage controls";
    }

    .controls {
      justify-self: end;
    }
  }
</style>
