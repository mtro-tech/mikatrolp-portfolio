---
// The Boston shaker that appears on the red in Behind the bar (animated version only):
// a large tin, the second tin that closes it, a jigger that pours a measure in, a small
// scoop that tips five ice cubes in, and splash marks for the shaking. No hand is drawn:
// the pieces move on their own.
// The tin stands on (0, 0); its mouth is at (0, -170), the point the whole shaker
// turns around (BehindTheBar.astro sets that as the transform origin).
// Everything is drawn flat, from the side, like the rest of the site (no openings
// seen from above):
// - pieces that end up inside the tin are drawn before it, so they vanish behind its
//   top edge;
// - a stream starts a little way inside the vessel it comes from, which is drawn over
//   it, so the stream's top end is never seen;
// - the ice lies inside the scoop: the scoop's wall is drawn over the cubes.
// behind-the-bar.motion.ts brings the pieces in.

// The corner of the jigger's rim once it has tipped. The measure leaves over the rim
// just right of that corner (the rim runs up to the right from it), not from the point.
const pour = { x: -28, y: -204 };
// The scoop's lip, where it rests over the tin's rim, and how far it tips (degrees).
const scoop = { x: -42, y: -200, tip: 22 };
// Scoop and load turn around the lip. Both carry the same unseen box, so "the lip" is
// the same corner (100% 100%) of each for GSAP, whatever else they hold.
const box = { x: -144, y: -72, width: 144, height: 72 };
// Five cubes: where each lies in the scoop (from its lip: a rising row, each centre
// behind the scoop's wall, so only the tops show) and where it ends up inside the tin,
// in the order they slide out. `turn` is how each is drawn turned.
// The cubes turn with the scoop, so their way into the tin is given in the tipped
// scoop's own directions.
const radians = (scoop.tip * Math.PI) / 180;
const round = (n: number) => Math.round(n * 10) / 10;
const cubes = [
  { from: [-18, -14], to: [-26, -118], turn: -10 },
  { from: [-32, -20], to: [22, -108], turn: 14 },
  { from: [-46, -26], to: [-4, -138], turn: 24 },
  { from: [-60, -32], to: [32, -138], turn: -18 },
  { from: [-74, -36], to: [-30, -146], turn: 8 },
].map(({ from, to, turn }) => {
  const x = to[0] - scoop.x;
  const y = to[1] - scoop.y;
  return {
    x: from[0],
    y: from[1],
    dx: round(x * Math.cos(radians) + y * Math.sin(radians) - from[0]),
    dy: round(-x * Math.sin(radians) + y * Math.cos(radians) - from[1]),
    turn,
  };
});
---

<svg
  class="shaker-svg"
  viewBox="-160 -300 320 320"
  aria-hidden="true"
  focusable="false"
>
  {/* Everything that shakes together. */}
  <g data-shake>
    {/* The measure: one band from inside the jigger's cup down into the tin. It
         grows from the top, and when the pouring stops its tail runs out downward. */}
    <g data-measure>
      <rect
        class="brass"
        data-measure-tail
        x={pour.x}
        y={pour.y - 16}
        width="7"
        height="66"
      ></rect>
    </g>

    {/* The ice, lying in the scoop. It turns with the scoop until it slides out. */}
    <g data-scoop-move>
      <g transform={`translate(${scoop.x} ${scoop.y})`}>
        <g data-scoop-turn>
          <rect class="unseen" {...box}></rect>
          {cubes.map(({ x, y, dx, dy, turn }) => (
            <g data-cube data-dx={dx} data-dy={dy}>
              <rect
                class="steel-light line"
                x={x - 10}
                y={y - 10}
                width="20"
                height="20"
                rx="3"
                transform={`rotate(${turn} ${x} ${y})`}
              />
            </g>
          ))}
        </g>
      </g>
    </g>

    {/* The scoop, drawn over the ice: a bowl with a rounded back, open at the lip
         on the right, on a brass handle. */}
    <g data-scoop-move data-scoop>
      <g transform={`translate(${scoop.x} ${scoop.y})`}>
        <g data-scoop-turn data-scoop-wall data-tip={scoop.tip}>
          <rect class="unseen" {...box}></rect>
          <rect
            class="brass line"
            x="-140"
            y="-30"
            width="56"
            height="12"
            rx="6"
          ></rect>
          <path
            class="steel-light line"
            d="M0 0L-72 0Q-88 0 -88 -16L-88 -38Q-88 -44 -82 -44L-76 -44L0 -8Z"
          ></path>
        </g>
      </g>
    </g>

    <g data-cap>
      <path
        class="steel-light line"
        d="M-52 -150L-40 -262Q-39 -270 -31 -270L31 -270Q39 -270 40 -262L52 -150Z"
      ></path>
    </g>
    <path
      class="steel-dark line"
      d="M-58 -170L-46 -8Q-45 0 -37 0L37 0Q45 0 46 -8L58 -170Z"
    ></path>
    <path class="line" d="M-56 -146L56 -146M-49 -30L49 -30"></path>
    <path
      class="mark"
      data-splash="top"
      d="M-34 -282L-46 -298M0 -286L0 -304M34 -282L46 -298"
    ></path>
    <path
      class="mark"
      data-splash="bottom"
      d="M-30 12L-40 28M0 14L0 32M30 12L40 28"
    ></path>
  </g>

  {/* The jigger: a steel measure, flat like the tin, drawn with the corner of its
       rim on (0, 0) and over the measure. GSAP moves the outer group and turns the
       inner one around that corner, so the measure comes out of the cup there. */}
  <g data-jigger>
    <g transform={`translate(${pour.x} ${pour.y}) scale(1.3)`}>
      <g data-jigger-tip>
        <path class="steel-light line" d="M-40 0L0 0L-14 34L-26 34Z"></path>
        <path class="steel-light line" d="M-26 34L-14 34L-6 56L-34 56Z"></path>
      </g>
    </g>
  </g>
</svg>

<style>
  .shaker-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The shaker changes size on stage, so its outlines are set in screen pixels. */
  .line,
  .mark {
    stroke-width: calc(var(--route-stroke-width) * 1px);
    vector-effect: non-scaling-stroke;
  }

  .line {
    stroke: var(--color-ink);
  }

  .mark {
    stroke: var(--color-paper);
  }

  .steel-light {
    fill: var(--color-paper);
  }

  .steel-dark {
    fill: var(--color-paper-deep);
  }

  .brass {
    fill: var(--color-brass);
  }

  /* Only there to give two groups the same box (see `box` above). */
  .unseen {
    fill: none;
    stroke: none;
  }

  /* Not on stage before their moments. */
  [data-measure],
  [data-scoop-move],
  [data-cap],
  [data-splash],
  [data-jigger] {
    opacity: 0;
  }
</style>
