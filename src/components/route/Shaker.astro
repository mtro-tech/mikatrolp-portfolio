---
// The Boston shaker that appears on the red in Behind the bar (animated version only):
// a large tin, the second tin that closes it, a jigger that pours a measure in, a small
// scoop that tips five ice cubes in, and splash marks for the shaking. No hand is drawn:
// the pieces move on their own.
// The tin stands on (0, 0); its mouth is at (0, -170), the point the whole shaker
// turns around (BehindTheBar.astro sets that as the transform origin).
// Pieces that end up inside the tin are drawn before it, so they vanish behind its rim.
// Every pour leaves from the lowest lip of its tipped vessel: the jigger turns around
// the corner of its rim, and the measure falls from exactly there.
// behind-the-bar.motion.ts brings the pieces in.

// The scoop's lip, where it rests over the tin's rim before it tips.
const scoop = { x: -42, y: -200 };
// Five cubes: where each lies on the scoop (from its lip) and where it ends up inside
// the tin, in the order they tumble in. `turn` is how each is drawn turned.
const cubes = [
  { from: [-22, -24], to: [-26, -118], turn: -10 },
  { from: [-34, -48], to: [22, -108], turn: 14 },
  { from: [-44, -30], to: [-4, -138], turn: 24 },
  { from: [-56, -54], to: [32, -138], turn: -18 },
  { from: [-66, -36], to: [-30, -146], turn: 8 },
].map(({ from, to, turn }) => {
  const x = scoop.x + from[0];
  const y = scoop.y + from[1];
  return { x, y, dx: to[0] - x, dy: to[1] - y, turn };
});
---

<svg
  class="shaker-svg"
  viewBox="-160 -300 320 320"
  aria-hidden="true"
  focusable="false"
>
  {/* Everything that shakes together. */}
  <g data-shake>
    {/* The measure: it grows down from the jigger's lip, then its tail runs out. */}
    <g data-measure>
      <rect
        class="brass"
        data-measure-tail
        x="-31.5"
        y="-204"
        width="7"
        height="54"
        rx="3.5"
      ></rect>
    </g>

    {/* The scoop: a small steel trough with a brass handle, lip to the right. */}
    <g data-scoop>
      <g transform={`translate(${scoop.x} ${scoop.y})`}>
        <g data-scoop-tip>
          <rect
            class="brass line"
            x="-142"
            y="-30"
            width="52"
            height="12"
            rx="6"
          ></rect>
          <path
            class="steel-light line"
            d="M0 0L-86 0Q-94 0 -94 -8L-94 -40L-84 -40L0 -10Z"
          ></path>
        </g>
      </g>
    </g>
    {cubes.map(({ x, y, dx, dy, turn }) => (
      <g data-cube data-dx={dx} data-dy={dy}>
        <rect
          class="steel-light line"
          x={x - 10}
          y={y - 10}
          width="20"
          height="20"
          rx="3"
          transform={`rotate(${turn} ${x} ${y})`}
        />
      </g>
    ))}

    <g data-cap>
      <path
        class="steel-light line"
        d="M-52 -150L-40 -262Q-39 -270 -31 -270L31 -270Q39 -270 40 -262L52 -150Z"
      ></path>
    </g>
    <path
      class="steel-dark line"
      d="M-58 -170L-46 -8Q-45 0 -37 0L37 0Q45 0 46 -8L58 -170Z"
    ></path>
    <path class="line" d="M-56 -146L56 -146M-49 -30L49 -30"></path>
    <path
      class="mark"
      data-splash="top"
      d="M-34 -282L-46 -298M0 -286L0 -304M34 -282L46 -298"
    ></path>
    <path
      class="mark"
      data-splash="bottom"
      d="M-30 12L-40 28M0 14L0 32M30 12L40 28"
    ></path>
  </g>

  {/* The jigger: an hourglass-shaped measure, drawn with the corner of its rim on
       (0, 0). GSAP moves the outer group and turns the inner one around that corner,
       so the corner is where the measure leaves it. */}
  <g data-jigger>
    <g transform="translate(-28 -204) scale(1.3)">
      <g data-jigger-tip>
        <path class="brass line" d="M-40 0L0 0L-14 34L-26 34Z"></path>
        <path class="brass line" d="M-26 34L-14 34L-6 56L-34 56Z"></path>
      </g>
    </g>
  </g>
</svg>

<style>
  .shaker-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The shaker changes size on stage, so its outlines are set in screen pixels. */
  .line,
  .mark {
    stroke-width: calc(var(--route-stroke-width) * 1px);
    vector-effect: non-scaling-stroke;
  }

  .line {
    stroke: var(--color-ink);
  }

  .mark {
    stroke: var(--color-paper);
  }

  .steel-light {
    fill: var(--color-paper);
  }

  .steel-dark {
    fill: var(--color-paper-deep);
  }

  .brass {
    fill: var(--color-brass);
  }

  /* Not on stage before their moments. */
  [data-measure],
  [data-scoop],
  [data-cube],
  [data-cap],
  [data-splash],
  [data-jigger] {
    opacity: 0;
  }
</style>
