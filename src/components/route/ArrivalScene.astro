---
// The Arrival map scene, in the house style (CLAUDE.md §4): objects are flat fills with
// an ink outline; the route is a plain red line that connects them.
// - the map ground (graticule, contour rings, lake) in the darker paper tone;
// - the route, which runs in along the ground to the pin and leaves downward;
// - St. Gallen standing on the route: a hill, houses, the abbey cathedral's twin towers;
// - a solid pin, a compass and a boat.
// Desktop (1440 × 900) enters from the left and pins at x = 1040. Phones (390 × 700) enter
// from the right and pin on the left rail at x = 39. Arrival.astro positions the copy from
// these numbers, and arrival.motion.ts zooms towards the pin.
import { contours, graticule } from "./contours";
import Pin from "./Pin.astro";

interface Props {
  place?: string;
  coordinates?: string;
}

const { place, coordinates } = Astro.props;

// The drawings scale with the page width only, so one unit is the same length in every
// chapter and the route meets exactly at each join. The stage can be taller than the
// drawing (tall, narrow screens), so the map ground extends beyond the viewBox:
// upwards on desktop (anchored to the bottom), downwards on phones (anchored to the top).
const desktop = {
  graticule: graticule(1440, 2000, 180),
  hills: [
    ...contours(1040, 600, { first: 46, step: 44, count: 15 }),
    ...contours(250, 250, { first: 30, step: 36, count: 5, seed: 2 }),
  ],
};

const mobile = {
  graticule: graticule(390, 1500, 110),
  hills: [
    ...contours(39, 210, { first: 30, step: 34, count: 9 }),
    ...contours(330, 560, { first: 24, step: 30, count: 5, seed: 2 }),
    ...contours(120, 1050, { first: 24, step: 30, count: 6, seed: 4 }),
  ],
};

// The town, drawn once in desktop units standing on the ground line y = 700.
// Each entry is one building, listed in the order the route passes them; it rises
// from the ground in that order. `shapes` are [class, path] pairs.
type Shape = [string, string];
const house = (
  left: number,
  width: number,
  wall: number,
  roof: number,
  roofClass = "fill-paper-deep",
): Shape[] => {
  const right = left + width;
  const eave = 700 - wall;
  const mid = left + width / 2;
  return [
    ["fill-paper ink-line", `M${left} 700V${eave}H${right}V700Z`],
    [
      `${roofClass} ink-line`,
      `M${left - 4} ${eave}L${mid} ${eave - roof}L${right + 4} ${eave}Z`,
    ],
    ["ink-line", `M${mid} ${700 - wall * 0.62}v${wall * 0.3}`],
  ];
};
const tower = (left: number): Shape[] => {
  const mid = left + 15;
  return [
    ["fill-paper ink-line", `M${left} 700V600H${left + 30}V700Z`],
    [
      "fill-brass ink-line",
      `M${left - 2} 600C${left - 2} 584 ${left + 8} 576 ${mid} 574C${left + 22} 576 ${left + 32} 584 ${left + 32} 600Z`,
    ],
    ["ink-line", `M${mid} 574V556`],
    ["ink-line", `M${mid} 618v16M${mid} 650v12`],
  ];
};
const town: Shape[][] = [
  house(584, 40, 26, 20),
  house(640, 48, 34, 22, "fill-route"),
  // The nave of the cathedral, then its two towers and the link between them.
  [
    ["fill-paper ink-line", "M706 700V662H756V700Z"],
    ["fill-paper-deep ink-line", "M702 662L720 642H756V662Z"],
    ["ink-line", "M722 676v12M738 676v12"],
  ],
  tower(756),
  [["fill-paper ink-line", "M786 700V640H806V700Z"]],
  tower(806),
  house(858, 36, 22, 16),
  house(912, 32, 16, 13, "fill-route"),
];

// Four-point compass star; the north point is the long one and gets the red half.
const star = "M0 -38L6 -6L26 0L6 6L0 26L-6 6L-26 0L-6 -6Z";
const north = "M0 -38L6 -6L-6 -6Z";
---

<svg
  class="scene scene--desktop"
  viewBox="0 0 1440 900"
  aria-hidden="true"
  focusable="false"
>
  <g class="ground">
    <!-- Lake Constance, north of the town. -->
    <path
      class="water"
      d="M770 96C860 58 1010 84 1130 122C1240 156 1360 150 1470 198L1470 262C1380 246 1290 266 1190 238C1080 206 960 186 868 186C806 186 748 146 770 96Z"
    ></path>
    <g transform="translate(0 -1100)">
      {desktop.graticule.map((d) => (
        <path class="grid" d={d} />
      ))}
    </g>
    {desktop.hills.map((d) => (
      <path class="contour" d={d} />
    ))}
  </g>

  {/* A small boat crossing Lake Constance: one of the hero's idle details. */}
  <g class="boat">
    <g transform="translate(900 150)">
      <path class="fill-paper ink-line" d="M-14 0h28l-5 7h-18z"></path>
      <path class="fill-paper ink-line" d="M0 -2V-22L11 -5z"></path>
    </g>
  </g>

  <g class="compass" transform="translate(1310 372)">
    <circle class="fill-paper ink-line" r="48"></circle>
    <circle class="compass-band" r="39"></circle>
    <g class="needle">
      <path class="fill-paper-deep ink-line" d={star}></path>
      <path class="fill-route ink-line" d={north}></path>
      <circle class="fill-brass ink-line" r="4"></circle>
    </g>
    <text class="north" y="-58" text-anchor="middle">
      N
    </text>
  </g>

  {/* The town is drawn a little larger than its units: it is the heart of the scene. */}
  <g
    class="town-scale"
    transform="translate(800 700) scale(1.3) translate(-800 -700)"
  >
    <path
      class="fill-paper-deep ink-line hill"
      d="M196 704C296 696 326 650 400 646C474 642 504 692 566 702Z"
    ></path>
    <g class="town">
      {town.map((shapes) => (
        <g class="building">
          {shapes.map(([cls, d]) => (
            <path class={cls} d={d} />
          ))}
        </g>
      ))}
    </g>
  </g>

  <path
    class="line skyline"
    pathLength="1"
    d="M-40 704C120 698 300 706 566 701L1040 700C1039.6 712 1040.4 724 1040 736"
  ></path>
  <path
    class="line route-start"
    data-route-start
    pathLength="1000"
    d="M1040 736C1039 790 1043 850 1040 920"
  ></path>

  <circle class="ring" cx="1040" cy="636" r="46"></circle>
  <g class="pin-drop">
    <Pin x={1040} y={700} radius={34} />
  </g>

  {place && (
    <text class="place" x="1100" y="632">
      {place}
    </text>
  )}
  {coordinates && (
    <text class="coordinates" x="1100" y="656">
      {coordinates}
    </text>
  )}
</svg>

<svg
  class="scene scene--mobile"
  viewBox="0 0 390 700"
  aria-hidden="true"
  focusable="false"
>
  <g class="ground">
    {mobile.graticule.map((d) => (
      <path class="grid" d={d} />
    ))}
    {mobile.hills.map((d) => (
      <path class="contour" d={d} />
    ))}
  </g>

  <g class="compass" transform="translate(292 82)">
    <circle class="fill-paper ink-line" r="28"></circle>
    <circle class="compass-band compass-band--small" r="22.5"></circle>
    <g class="needle">
      <g transform="scale(0.58)" class="half-size">
        <path class="fill-paper-deep ink-line" d={star}></path>
        <path class="fill-route ink-line" d={north}></path>
        <circle class="fill-brass ink-line" r="4"></circle>
      </g>
    </g>
    <text class="north" y="-35" text-anchor="middle">
      N
    </text>
  </g>

  {
    // The same town at half size, mirrored: on phones the route comes in from the right.
  }
  <g
    class="half-size"
    transform="translate(594 230) scale(-0.5 0.5) translate(0 -700)"
  >
    <path
      class="fill-paper-deep ink-line hill"
      d="M196 704C296 696 326 650 400 646C474 642 504 692 566 702Z"
    ></path>
    <g class="town">
      {town.map((shapes) => (
        <g class="building">
          {shapes.map(([cls, d]) => (
            <path class={cls} d={d} />
          ))}
        </g>
      ))}
    </g>
  </g>

  <path
    class="line skyline"
    pathLength="1"
    d="M400 233C370 230 340 233 311 231L39 230C38.6 244 39.4 258 39 272"
  ></path>
  <path
    class="line route-start"
    data-route-start
    pathLength="1000"
    d="M39 272C38 500 40 900 39 1400"
  ></path>

  <circle class="ring" cx="39" cy="196" r="25"></circle>
  <g class="pin-drop">
    <Pin x={39} y={230} radius={18} />
  </g>

  {place && (
    <text class="place" x="68" y="186">
      {place}
    </text>
  )}
  {coordinates && (
    <text class="coordinates" x="68" y="201">
      {coordinates}
    </text>
  )}
</svg>

<style>
  .scene {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scene--desktop {
    display: none;
  }

  @media (width >= 60rem) {
    .scene--desktop {
      display: block;
      top: auto;
      bottom: 0;
    }

    .scene--mobile {
      display: none;
    }
  }

  /* Map ground: present, but quiet enough to sit behind the copy. */
  .grid,
  .contour {
    stroke: var(--color-paper-deep);
  }

  .grid {
    stroke-width: calc(
      var(--map-grid-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
  }

  .contour {
    stroke-width: calc(
      var(--map-contour-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
  }

  .water {
    fill: var(--color-paper-deep);
  }

  .line {
    stroke: var(--color-route);
    stroke-width: calc(
      var(--route-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
    stroke-dasharray: 1;
  }

  /* The scroll-drawn part counts its length in 1000 steps: GSAP rounds the offset to
     whole pixels, so a length of 1 could only ever be drawn or not drawn. */
  .route-start {
    stroke-dasharray: 1000;
  }

  /* Drawn at half size on phones: outlines inside are doubled, so they stay as thick
     on screen as everywhere else (route.css divides stroke widths by --zoom). */
  .half-size {
    --zoom: 0.5;
  }

  .compass .half-size {
    --zoom: 0.58;
  }

  .town-scale {
    --zoom: 1.3;
  }

  .ring {
    stroke: var(--color-brass);
    stroke-width: calc(
      var(--route-detail-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
  }

  /* The brass band of the compass, between its ink outline and the needle. */
  .compass-band {
    stroke: var(--color-brass);
    stroke-width: 8;
  }

  .compass-band--small {
    stroke-width: 5;
  }

  .place,
  .coordinates,
  .north {
    stroke: none;
    fill: var(--color-ink-soft);
  }

  .place {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 24px;
  }

  .coordinates,
  .north {
    font-family: var(--font-text);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .scene--mobile .place {
    font-size: 16px;
  }

  .scene--mobile .coordinates,
  .scene--mobile .north {
    font-size: 10.5px;
  }

  /* Rotations and scales pivot on each shape's own centre. */
  .ground,
  .needle,
  .ring {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Buildings and the hill grow out of the ground they stand on. */
  .building,
  .hill {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  /* Load sequence (peak 1). The reader should feel a map being unrolled and a place
     coming to life on it: the ground first, then the route running in along it, the
     town rising house by house as the line passes, and last the pin landing.
     data-motion is set before first paint (Base.astro); without it everything is static. */
  :global(html[data-motion="on"]) .ground {
    animation: unroll var(--duration-ground) var(--ease-settle) both;
  }

  :global(html[data-motion="on"]) .skyline {
    animation: draw var(--duration-draw) var(--ease-draw) var(--delay-draw) both;
  }

  :global(html[data-motion="on"]) .hill {
    animation: building-grow var(--duration-building) var(--ease-settle)
      calc(var(--delay-town) - var(--delay-building) * 2) both;
  }

  :global(html[data-motion="on"]) .building {
    animation: building-grow var(--duration-building) var(--ease-settle)
      calc(var(--delay-town) + var(--i) * var(--delay-building)) both;
  }

  .building:nth-child(1) {
    --i: 0;
  }

  .building:nth-child(2) {
    --i: 1;
  }

  .building:nth-child(3) {
    --i: 2;
  }

  .building:nth-child(4) {
    --i: 3;
  }

  .building:nth-child(5) {
    --i: 4;
  }

  .building:nth-child(6) {
    --i: 5;
  }

  .building:nth-child(7) {
    --i: 6;
  }

  .building:nth-child(8) {
    --i: 7;
  }

  /* The skyline path ends in a short stub below the pin. The rest of the route stays
     undrawn until the reader scrolls (arrival.motion.ts draws it; no CSS animation here). */
  :global(html[data-motion="on"]) .route-start {
    stroke-dashoffset: 1000;
  }

  /* The pin drops onto the end of the line and settles. */
  :global(html[data-motion="on"]) .pin-drop {
    animation: drop var(--duration-land) var(--ease-settle) var(--delay-landed)
      both;
  }

  /* Around it a brass ring keeps breathing: the first of the idle details. */
  :global(html[data-motion="on"]) .ring {
    animation:
      appear var(--duration-fade) var(--ease-settle)
        calc(var(--delay-landed) + var(--duration-land)) both,
      idle-pulse var(--duration-pulse) ease-in-out
        calc(var(--delay-landed) + var(--duration-land)) infinite;
  }

  :global(html[data-motion="on"]) .place,
  :global(html[data-motion="on"]) .coordinates {
    animation: appear var(--duration-fade) var(--ease-settle)
      var(--delay-landed) both;
  }

  :global(html[data-motion="on"]) .compass {
    animation: appear var(--duration-fade) var(--ease-settle) var(--delay-draw)
      both;
  }

  /* Once settled, the needle never rests completely. */
  :global(html[data-motion="on"]) .needle {
    animation:
      needle-settle var(--duration-needle) var(--ease-settle) var(--delay-draw) both,
      tremble var(--duration-tremble) ease-in-out
        calc(var(--delay-draw) + var(--duration-needle)) infinite alternate;
  }

  /* The boat takes most of a minute to cross the lake, then turns back. */
  :global(html[data-motion="on"]) .boat {
    animation:
      appear var(--duration-fade) var(--ease-settle) var(--delay-landed) both,
      voyage var(--duration-voyage) ease-in-out var(--delay-landed) infinite
        alternate;
  }

  @keyframes unroll {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  @keyframes building-grow {
    from {
      opacity: 0;
      scale: 1 0;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      translate: 0 -70px;
    }
  }

  @keyframes tremble {
    from {
      rotate: -3deg;
    }

    to {
      rotate: 3deg;
    }
  }

  @keyframes voyage {
    to {
      translate: 420px 62px;
    }
  }

  /* A compass needle that was just set down: it overshoots north, then rests. */
  @keyframes needle-settle {
    0% {
      rotate: -70deg;
    }

    55% {
      rotate: 14deg;
    }

    80% {
      rotate: -5deg;
    }

    100% {
      rotate: 0deg;
    }
  }
</style>
