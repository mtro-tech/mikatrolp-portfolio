---
// The Arrival map scene. Two layers:
// - the map ground (graticule, contour rings, lake) in the darker paper tone;
// - the pen line, which arrives over the hills, traces St. Gallen's rooftops and the twin
//   towers of the abbey cathedral in one stroke, loops into the pin and leaves as the route.
// Desktop (1440 × 900) enters from the left and pins at x = 1040. Mobile (390 × 700) enters
// from the right and pins on the left rail at x = 39. Arrival.astro positions the copy from
// these numbers, and arrival.motion.ts zooms towards the pin.
import { contours, graticule } from "./contours";

interface Props {
  place?: string;
  coordinates?: string;
}

const { place, coordinates } = Astro.props;

// The drawings scale with the page width only, so one unit is the same length in every
// chapter and the route meets exactly at each join. The stage can be taller than the
// drawing (tall, narrow screens), so the map ground extends beyond the viewBox:
// upwards on desktop (anchored to the bottom), downwards on phones (anchored to the top).
const desktop = {
  graticule: graticule(1440, 2000, 180),
  hills: [
    ...contours(1040, 600, { first: 46, step: 44, count: 15 }),
    ...contours(250, 250, { first: 30, step: 36, count: 5, seed: 2 }),
  ],
};

const mobile = {
  graticule: graticule(390, 1500, 110),
  hills: [
    ...contours(39, 210, { first: 30, step: 34, count: 9 }),
    ...contours(330, 560, { first: 24, step: 30, count: 5, seed: 2 }),
    ...contours(120, 1050, { first: 24, step: 30, count: 6, seed: 4 }),
  ],
};

// Four-point compass star; the north point is the long one.
const star = "M0 -38L6 -6L26 0L6 6L0 26L-6 6L-26 0L-6 -6Z";
---

<svg
  class="scene scene--desktop"
  viewBox="0 0 1440 900"
  aria-hidden="true"
  focusable="false"
>
  <g class="ground">
    <!-- Lake Constance, north of the town. -->
    <path
      class="water"
      d="M770 96C860 58 1010 84 1130 122C1240 156 1360 150 1470 198L1470 262C1380 246 1290 266 1190 238C1080 206 960 186 868 186C806 186 748 146 770 96Z"
    ></path>
    <g transform="translate(0 -1100)">
      {desktop.graticule.map((d) => (
        <path class="grid" d={d} />
      ))}
    </g>
    {desktop.hills.map((d) => (
      <path class="contour" d={d} />
    ))}
  </g>

  {/* A small boat crossing Lake Constance: one of the hero's idle details. */}
  <g class="boat">
    <g transform="translate(900 150)">
      <path class="fill-paper ink-line" d="M-14 0h28l-5 7h-18z" />
      <path class="fill-paper ink-line" d="M0 -2V-22L11 -5z" />
    </g>
  </g>

  <g class="compass" transform="translate(1310 372)">
    <circle r="46"></circle>
    <circle r="3"></circle>
    <path class="needle" d={star}></path>
    <text class="north" y="-56" text-anchor="middle">
      N
    </text>
  </g>

  <path
    class="line skyline"
    pathLength="1"
    d="M-40 706C60 698 140 712 230 702C300 694 330 650 400 646C470 642 500 690 560 700L584 700L584 676L604 660L624 676L624 700L640 701L640 668L664 650L688 668L688 700L706 700L706 662L722 644L756 644L756 600C756 586 764 578 770 576L770 558L772 576C778 578 786 586 786 600L786 640L806 640L806 600C806 586 814 578 820 576L820 558L822 576C828 578 836 586 836 600L836 700L858 701L858 678L876 664L894 678L894 700L912 700L912 684L928 672L944 684L944 700C980 703 1010 698 1040 700C1040 700 1006 664 1006 636A34 34 0 1 1 1074 636C1074 664 1040 700 1040 700C1039.6 712 1040.4 724 1040 736"
  ></path>
  <path
    class="line route-start"
    data-route-start
    pathLength="1000"
    d="M1040 736C1039 790 1043 850 1040 920"
  ></path>
  <circle class="ring" cx="1040" cy="636" r="10"></circle>

  {place && (
    <text class="place" x="1096" y="632">
      {place}
    </text>
  )}
  {coordinates && (
    <text class="coordinates" x="1096" y="656">
      {coordinates}
    </text>
  )}
</svg>

<svg
  class="scene scene--mobile"
  viewBox="0 0 390 700"
  aria-hidden="true"
  focusable="false"
>
  <g class="ground">
    {mobile.graticule.map((d) => (
      <path class="grid" d={d} />
    ))}
    {mobile.hills.map((d) => (
      <path class="contour" d={d} />
    ))}
  </g>

  <g class="compass" transform="translate(292 82)">
    <circle r="27"></circle>
    <circle r="2"></circle>
    <path class="needle" d={star} transform="scale(0.58)"></path>
    <text class="north" y="-33" text-anchor="middle">
      N
    </text>
  </g>

  <path
    class="line skyline"
    pathLength="1"
    d="M400 234C372 228 356 206 334 204C312 202 302 226 286 230L272 230L272 190C272 182 267 178 264 177L264 165L262.8 177C260 178 256 182 256 190L256 212L246 212L246 190C246 182 242 178 238 177L238 165L236.8 177C234 178 230 182 230 190L230 214L208 214L198 224L198 230L186 230L186 216L174 206L162 216L162 230L150 231L150 212L136 202L122 212L122 230C100 233 70 228 39 230C39 230 21 210 21 194A18 18 0 1 1 57 194C57 210 39 230 39 230C38.6 244 39.4 258 39 272"
  ></path>
  <path
    class="line route-start"
    data-route-start
    pathLength="1000"
    d="M39 272C38 500 40 900 39 1400"
  ></path>
  <circle class="ring" cx="39" cy="194" r="5.5"></circle>

  {place && (
    <text class="place" x="66" y="172">
      {place}
    </text>
  )}
  {coordinates && (
    <text class="coordinates" x="66" y="187">
      {coordinates}
    </text>
  )}
</svg>

<style>
  .scene {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scene--desktop {
    display: none;
  }

  @media (width >= 60rem) {
    .scene--desktop {
      display: block;
      top: auto;
      bottom: 0;
    }

    .scene--mobile {
      display: none;
    }
  }

  /* Map ground: present, but quiet enough to sit behind the copy. */
  .grid,
  .contour {
    stroke: var(--color-paper-deep);
  }

  .grid {
    stroke-width: calc(
      var(--map-grid-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
  }

  .contour {
    stroke-width: calc(
      var(--map-contour-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
  }

  .water {
    fill: var(--color-paper-deep);
  }

  .line {
    stroke: var(--color-route);
    stroke-width: calc(
      var(--route-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
    stroke-dasharray: 1;
  }

  /* The scroll-drawn part counts its length in 1000 steps: GSAP rounds the offset to
     whole pixels, so a length of 1 could only ever be drawn or not drawn. */
  .route-start {
    stroke-dasharray: 1000;
  }

  .ring,
  .compass {
    stroke: var(--color-brass);
    stroke-width: calc(
      var(--route-detail-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
  }

  .place,
  .coordinates,
  .north {
    stroke: none;
    fill: var(--color-ink-soft);
  }

  .place {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 24px;
  }

  .coordinates,
  .north {
    font-family: var(--font-text);
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .scene--mobile .place {
    font-size: 16px;
  }

  .scene--mobile .coordinates,
  .scene--mobile .north {
    font-size: 10.5px;
  }

  /* Rotations and scales pivot on each shape's own centre. */
  .ground,
  .needle,
  .ring {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Load sequence (peak 1). The reader should feel a map being unrolled and a route
     being inked onto it: ground first, then the line, then the pin lands.
     data-motion is set before first paint (Base.astro); without it everything is static. */
  :global(html[data-motion="on"]) .ground {
    animation: unroll var(--duration-ground) var(--ease-settle) both;
  }

  :global(html[data-motion="on"]) .skyline {
    animation: draw var(--duration-draw) var(--ease-draw) var(--delay-draw) both;
  }

  /* The skyline path ends in a short stub below the pin. The rest of the route stays
     undrawn until the reader scrolls (arrival.motion.ts draws it; no CSS animation here). */
  :global(html[data-motion="on"]) .route-start {
    stroke-dashoffset: 1000;
  }

  /* After landing, the ring keeps breathing: the first of the idle details. */
  :global(html[data-motion="on"]) .ring {
    animation:
      land var(--duration-land) var(--ease-settle) var(--delay-landed) both,
      idle-pulse var(--duration-pulse) ease-in-out
        calc(var(--delay-landed) + var(--duration-land)) infinite;
  }

  :global(html[data-motion="on"]) .place,
  :global(html[data-motion="on"]) .coordinates {
    animation: appear var(--duration-fade) var(--ease-settle)
      var(--delay-landed) both;
  }

  :global(html[data-motion="on"]) .compass {
    animation: appear var(--duration-fade) var(--ease-settle) var(--delay-draw)
      both;
  }

  /* Once settled, the needle never rests completely. */
  :global(html[data-motion="on"]) .needle {
    animation:
      settle var(--duration-needle) var(--ease-settle) var(--delay-draw) both,
      tremble var(--duration-tremble) ease-in-out
        calc(var(--delay-draw) + var(--duration-needle)) infinite alternate;
  }

  /* The boat takes most of a minute to cross the lake, then turns back. */
  :global(html[data-motion="on"]) .boat {
    animation:
      appear var(--duration-fade) var(--ease-settle) var(--delay-landed) both,
      voyage var(--duration-voyage) ease-in-out var(--delay-landed) infinite
        alternate;
  }

  @keyframes unroll {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  /* The brass ring arrives large and faint, then tightens onto the pin. */
  @keyframes land {
    from {
      opacity: 0;
      scale: 3;
    }
  }

  @keyframes tremble {
    from {
      rotate: -3deg;
    }

    to {
      rotate: 3deg;
    }
  }

  @keyframes voyage {
    to {
      translate: 420px 62px;
    }
  }

  /* A compass needle that was just set down: it overshoots north, then rests. */
  @keyframes settle {
    0% {
      rotate: -70deg;
    }

    55% {
      rotate: 14deg;
    }

    80% {
      rotate: -5deg;
    }

    100% {
      rotate: 0deg;
    }
  }
</style>
