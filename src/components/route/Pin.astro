---
// The map pin, in the house style: a solid red drop with an ink outline and a paper
// centre. Drawn with its tip at (x, y), so it stands exactly on the route.
// `radius` is the radius of the round head; the whole pin is about 2.9 radii tall.
interface Props {
  x: number;
  y: number;
  radius: number;
  class?: string;
}

const { x, y, radius: r, class: className, ...rest } = Astro.props;
const round = (n: number) => Math.round(n * 10) / 10;
const head = round(-1.88 * r);
const shoulder = round(-1.06 * r);
const body = `M0 0C0 0 ${-r} ${shoulder} ${-r} ${head}A${r} ${r} 0 1 1 ${r} ${head}C${r} ${shoulder} 0 0 0 0Z`;
---

<g class:list={["pin", className]} transform={`translate(${x} ${y})`} {...rest}>
  <path class="fill-route ink-line" d={body}></path>
  <circle
    class="fill-paper ink-line"
    cx="0"
    cy={head}
    r={round(0.36 * r)}
  ></circle>
</g>
