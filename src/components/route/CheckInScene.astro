---
// The Check-in drawings for the staged scene (choreography: chapters/check-in.motion.ts).
// - "desktop" (1440 × 810): the route comes in from the hero at x = 1040 and ends in a
//   hook; a room key hangs from it. Left of the key a map sheet carries the leg from
//   St. Gallen to Lucerne, and the route leaves downward at x = 720.
// - "key" and "map" (390 × 340): the same two drawings for phones, shown one after the
//   other in the top half of the frame. The rail at x = 39 is drawn by the frame itself.
// data-* attributes are the handles the choreography animates.
import { contours, graticule } from "./contours";
import Pin from "./Pin.astro";

interface Props {
  part: "desktop" | "key" | "map";
  origin?: string;
  place?: string;
}

const { part, origin, place } = Astro.props;

// Lamplight flecks for the dark scene: fixed positions, so every build looks the same.
const flecks =
  part === "desktop"
    ? [
        [180, 120, 5],
        [330, 560, 4],
        [470, 260, 6],
        [560, 640, 4],
        [650, 110, 5],
        [740, 430, 7],
        [820, 240, 4],
        [880, 620, 6],
        [930, 90, 4],
        [1180, 520, 6],
        [1250, 180, 5],
        [1330, 400, 4],
        [1210, 690, 5],
        [260, 360, 4],
        [1120, 60, 4],
        [420, 720, 5],
      ]
    : [
        [70, 60, 3],
        [120, 210, 4],
        [170, 110, 3],
        [200, 290, 3],
        [320, 40, 4],
        [340, 190, 3],
        [150, 310, 4],
        [360, 300, 3],
      ];

const ground =
  part === "desktop"
    ? {
        grid: graticule(1440, 810, 150),
        hills: [
          ...contours(900, 260, { first: 26, step: 30, count: 6 }),
          ...contours(620, 500, { first: 30, step: 32, count: 7, seed: 1 }),
          ...contours(880, 590, { first: 22, step: 28, count: 5, seed: 3 }),
        ],
      }
    : {
        grid: graticule(390, 340, 110),
        hills: [
          ...contours(270, 70, { first: 16, step: 20, count: 5 }),
          ...contours(110, 210, { first: 22, step: 22, count: 6, seed: 1 }),
        ],
      };
---

{
  // The room key, drawn hanging from (1040, 150). Phones reuse it at a smaller scale.
  // Three nested groups, so idle sway (CSS) and the choreography (GSAP) never share one:
  // data-key (GSAP) > .idle-sway (CSS) > data-key-turn (GSAP).
}
{part !== "map" && (
  <svg
    class="scene-svg"
    viewBox={part === "desktop" ? "0 0 1440 810" : "0 0 390 340"}
    aria-hidden="true"
    focusable="false"
  >
    <g data-flecks class="flecks">
      {flecks.map(([x, y, r]) => (
        <circle class="fleck fill-brass" cx={x} cy={y} r={r} />
      ))}
    </g>

    {part === "desktop" && (
      <g data-map class="map">
        <defs>
          <clipPath id="check-in-sheet">
            <rect x="480" y="170" width="500" height="500" rx="6" />
          </clipPath>
        </defs>
        <g transform="rotate(-1.2 730 420)">
          <rect
            class="map-sheet"
            x="480"
            y="170"
            width="500"
            height="500"
            rx="6"
          />
          <g class="on-sheet" clip-path="url(#check-in-sheet)">
            {ground.grid.map((d) => (
              <path class="map-grid" d={d} />
            ))}
            {/* Lake Zurich, north-west of the leg; Lake Lucerne, south-east of the town. */}
            <path
              class="map-water"
              d="M566 290C616 294 672 316 718 346C726 354 720 364 710 360C664 336 614 320 564 312C554 308 556 290 566 290Z"
            />
            <path
              class="map-water"
              d="M672 548C702 538 728 548 754 560C780 552 812 554 818 566C822 576 792 580 774 576C780 592 760 604 748 592C742 582 728 574 710 570C690 566 664 562 672 548Z"
            />
            {ground.hills.map((d) => (
              <path class="map-contour" d={d} />
            ))}
          </g>
          {/* Light on the water. */}
          <path class="map-contour idle-shimmer" d="M610 314h44" />
          <path
            class="map-contour idle-shimmer idle-shimmer--late"
            d="M712 562h40"
          />
        </g>
        {origin && (
          <text class="map-label" x="880" y="248" text-anchor="end">
            {origin}
          </text>
        )}
        {place && (
          <text class="map-label" x="572" y="464" text-anchor="end">
            {place}
          </text>
        )}
      </g>
    )}

    {/* The route. Desktop: down from the hero to the hook. Phones: a branch off the rail. */}
    <path
      class="route-line"
      d={
        part === "desktop"
          ? "M1040 -1200L1040 150"
          : "M39 30C39 60 250 28 250 70"
      }
    />

    {part === "desktop" && (
      <>
        <path
          class="route-line route-draw"
          data-route
          pathLength="1000"
          d="M1040 150C1040 190 960 210 900 260C840 320 740 380 690 440C660 480 640 500 620 520C620 600 720 610 720 700L720 2000"
        />
        {/* St. Gallen: a small outlined marker. Lucerne: the same pin as in the hero. */}
        <g data-marker class="pivot">
          <circle class="fill-paper ink-line" cx="900" cy="260" r="9" />
          <circle class="fill-route" cx="900" cy="260" r="3.5" />
        </g>
        <g data-halo>
          <circle class="brass pivot idle-pulse" cx="620" cy="456" r="46" />
        </g>
        <g data-pin>
          <Pin x={620} y={520} radius={34} />
        </g>
      </>
    )}

    {/* The paper plane to Toronto and its dashed trail. */}
    <path
      class="trail"
      data-trail
      pathLength="1000"
      d={part === "desktop" ? "M680 790L930 -20" : "M30 330L170 -10"}
    />
    <g
      data-plane
      class="plane"
      data-dx={part === "desktop" ? 250 : 140}
      data-dy={part === "desktop" ? -810 : -340}
    >
      <g
        transform={
          part === "desktop"
            ? "translate(680 790) rotate(-72.8)"
            : "translate(30 330) rotate(-67.6) scale(0.7)"
        }
      >
        <path class="fill-paper ink-line" d="M22 0L-22 -15L-12 0L-22 15Z" />
        <path class="ink-line" d="M22 0L-12 0" />
      </g>
    </g>

    <g data-key class="key">
      <g
        class:list={[
          "idle-sway",
          part === "desktop" ? "hang--desktop" : "hang--phone",
        ]}
      >
        <g
          transform={
            part === "desktop"
              ? undefined
              : "translate(250 70) scale(0.62) translate(-1040 -150)"
          }
        >
          <path class="route-line" d="M1040 150L1040 208" />
          {/* The fob: a red tag on its own short cord, swinging a beat behind the key. */}
          <g class="idle-sway idle-sway--late fob">
            <path class="brass" d="M1072 222C1092 232 1104 250 1110 276" />
            <g transform="rotate(14 1112 330)">
              <rect
                class="fill-route ink-line"
                x="1088"
                y="276"
                width="48"
                height="96"
                rx="14"
              />
              <rect
                class="fob-edge"
                x="1095"
                y="296"
                width="34"
                height="68"
                rx="9"
              />
              <circle class="fill-paper ink-line" cx="1112" cy="288" r="5" />
            </g>
          </g>
          <g data-key-turn>
            <circle class="key-ring" cx="1040" cy="250" r="33" />
            <circle class="ink-line" cx="1040" cy="250" r="44" />
            <circle class="ink-line" cx="1040" cy="250" r="22" />
            <rect
              class="fill-brass ink-line"
              x="1026"
              y="290"
              width="28"
              height="12"
              rx="3"
            />
            <rect
              class="fill-brass ink-line"
              x="1032"
              y="302"
              width="16"
              height="160"
              rx="3"
            />
            <path
              class="fill-brass ink-line"
              d="M1048 392h28v20h-12v10h12v20h-28z"
            />
            {/* Balances the teeth, so the turn pivots exactly on the ring's centre. */}
            <rect class="balance" x="996" y="206" width="88" height="256" />
          </g>
          <circle data-keyhole class="balance" cx="1040" cy="250" r="1" />
        </g>
      </g>
    </g>
  </svg>
)}

{part === "map" && (
  <svg
    class="scene-svg"
    viewBox="0 0 390 340"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <clipPath id="check-in-sheet-phone">
        <rect x="58" y="20" width="320" height="300" rx="4" />
      </clipPath>
    </defs>

    <g data-map class="map">
      <g transform="rotate(-1.5 218 170)">
        <rect class="map-sheet" x="58" y="20" width="320" height="300" rx="4" />
        <g class="on-sheet" clip-path="url(#check-in-sheet-phone)">
          {ground.grid.map((d) => (
            <path class="map-grid" d={d} />
          ))}
          <path
            class="map-water"
            d="M108 64C138 68 168 80 194 98C198 102 194 108 188 106C162 92 136 82 106 76C100 74 102 64 108 64Z"
          />
          <path
            class="map-water"
            d="M190 260C216 252 238 260 260 270C280 262 304 266 308 276C310 284 288 286 274 282C278 296 262 304 252 294C246 286 236 280 222 276C206 274 184 270 190 260Z"
          />
          {ground.hills.map((d) => (
            <path class="map-contour" d={d} />
          ))}
        </g>
        <path class="map-contour idle-shimmer" d="M132 78h30" />
        <path
          class="map-contour idle-shimmer idle-shimmer--late"
          d="M224 272h30"
        />
      </g>
      {origin && (
        <text class="map-label map-label--small" x="284" y="62">
          {origin}
        </text>
      )}
      {place && (
        <text class="map-label map-label--small" x="124" y="266">
          {place}
        </text>
      )}
    </g>

    <path
      class="route-line route-draw"
      data-route
      pathLength="1000"
      d="M39 0C39 40 170 30 270 70C230 104 190 124 170 160C150 196 130 220 110 240C110 300 39 290 39 340"
    />
    <g data-marker class="pivot">
      <circle class="fill-paper ink-line" cx="270" cy="70" r="6" />
      <circle class="fill-route" cx="270" cy="70" r="2.5" />
    </g>
    <g data-halo>
      <circle class="brass pivot idle-pulse" cx="110" cy="206" r="25" />
    </g>
    <g data-pin>
      <Pin x={110} y={240} radius={18} />
    </g>
  </svg>
)}

<style>
  /* The ring of the key: a thick brass band between two ink outlines. */
  .key-ring {
    stroke: var(--color-brass);
    stroke-width: 22;
  }

  .fob-edge {
    stroke: var(--color-paper);
    stroke-width: 1.5;
    opacity: 0.7;
  }

  /* Invisible shapes that only give a group the right bounding box or a handle. */
  .balance {
    stroke: none;
    fill: none;
  }

  .trail {
    stroke: var(--color-ink-soft);
    stroke-width: calc(
      var(--route-detail-stroke-width) / var(--route-scale, 1) / var(--zoom, 1)
    );
    stroke-dasharray: 14 12;
  }

  /* The scroll-drawn part of the route counts its length in 1000 steps (GSAP rounds
     stroke-dashoffset to whole pixels). */
  .route-draw {
    stroke-dasharray: 1000;
  }

  /* The key and its fob swing from where they hang. */
  .hang--desktop {
    transform-box: view-box;
    transform-origin: 1040px 150px;
  }

  .hang--phone {
    transform-box: view-box;
    transform-origin: 250px 70px;
  }

  .fob {
    transform-box: view-box;
    transform-origin: 1072px 222px;
  }

  .fleck {
    opacity: 0.7;
  }

  /* Lamplight: the flecks rise a little and dim, each on its own rhythm. */
  :global(html[data-motion="on"]) .fleck {
    animation: drift var(--duration-drift) ease-in-out infinite alternate;
  }

  :global(html[data-motion="on"]) .fleck:nth-child(3n) {
    animation-duration: calc(var(--duration-drift) * 1.4);
    animation-delay: calc(var(--duration-drift) * -0.6);
  }

  :global(html[data-motion="on"]) .fleck:nth-child(3n + 1) {
    animation-duration: calc(var(--duration-drift) * 0.8);
    animation-delay: calc(var(--duration-drift) * -0.3);
  }

  @keyframes drift {
    from {
      translate: 0 14px;
      opacity: 0.25;
    }

    to {
      translate: 6px -18px;
      opacity: 0.8;
    }
  }

  /* Before the choreography reaches them, these are not on stage. With motion off they
     are simply there (the flecks and the plane belong to the animated version only). */
  :global(html[data-motion="on"]) .map,
  :global(html[data-motion="on"]) .flecks,
  :global(html[data-motion="on"]) .plane,
  :global(html[data-motion="on"]) .trail {
    opacity: 0;
  }

  :global(html[data-motion="on"]) .route-draw {
    stroke-dashoffset: 1000;
  }

  :global(html:not([data-motion="on"])) .flecks,
  :global(html:not([data-motion="on"])) .plane,
  :global(html:not([data-motion="on"])) .trail {
    display: none;
  }
</style>
